TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_api_secret
TRELLO_TOKEN=your_trello_user_token
TRELLO_BOARD_URL=https://trello.com/b/your-board-shortlink/your-board-name
TRELLO_TARGET_LISTS=To-Do,In Progress,Blocked,Done
TRELLO_AGENT_USERNAME=your_agent_username
TRELLO_AGENT_MEMBER_ID=your_agent_member_id
POLL_INTERVAL_MS=300000
TRELLO_WEBHOOK_HOST=127.0.0.1
TRELLO_WEBHOOK_PORT=8787
TRELLO_WEBHOOK_PATH=/trello/webhook
TRELLO_WEBHOOK_CALLBACK_URL=http://localhost:8787/trello/webhook
TRELLO_WEBHOOK_DESCRIPTION=Codex Trello Board Webhook
ORACLE_TRELLO_SSH_HOST=your-remote-host.example.com
ORACLE_TRELLO_SSH_USER=your_ssh_user
ORACLE_TRELLO_SSH_KEY_PATH=C:\\path\\to\\your\\ssh_key
ORACLE_TRELLO_REMOTE_DIR=/path/to/your/trello-webhook-workspace
