[Unit]
Description=Dispatch labeled Trello cards to assigned agents
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/central-tasks
ExecStart=/usr/bin/python3 /home/ubuntu/central-tasks/scripts/trello-dispatcher.py
Nice=5
IOSchedulingClass=best-effort

